load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "run.sh.tmpl",
    "trivy.py",
    "versions.bzl",
])

filegroup(
    name = "srcs",
    srcs = glob(["*"]),
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
)

bzl_library(
    name = "data",
    srcs = ["data.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    deps = [":versions"],
)

bzl_library(
    name = "test",
    srcs = ["test.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "info",
    srcs = ["info.bzl"],
    deps = [
        ":providers",
        ":test",
        ":versions",
    ],
)
