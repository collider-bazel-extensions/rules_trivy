load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_trivy//:defs.bzl", "trivy_config_test", "trivy_ignore_test", "trivy_image_test")
load("@tar.bzl//tar:tar.bzl", "tar")

tar(
    name = "layer",
    srcs = [
        "installed",
        "os-release",
    ],
    mtree = [
        "./etc uid=0 gid=0 mode=0755 type=dir",
        "./etc/os-release uid=0 gid=0 mode=0644 time=0 type=file content=$(location os-release)",
        "./lib uid=0 gid=0 mode=0755 type=dir",
        "./lib/apk uid=0 gid=0 mode=0755 type=dir",
        "./lib/apk/db uid=0 gid=0 mode=0755 type=dir",
        "./lib/apk/db/installed uid=0 gid=0 mode=0644 time=0 type=file content=$(location installed)",
    ],
)

oci_image(
    name = "image",
    architecture = "amd64",
    os = "linux",
    tars = [":layer"],
)

# zlib 1.3.1-r2's two HIGH CVEs, accepted: passes at HIGH.
trivy_image_test(
    name = "image_test",
    ignore = "accepted.trivyignore.yaml",
    image = ":image",
)

trivy_config_test(
    name = "config_test",
    srcs = ["deployment.yaml"],
)

trivy_ignore_test(
    name = "ignore_test",
    src = "accepted.trivyignore.yaml",
)
