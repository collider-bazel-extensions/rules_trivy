"""Test images (no base image, nothing pulled): see images.bzl."""

load("@rules_oci//oci:defs.bzl", "oci_image_index", "oci_load")
load(":images.bzl", "alpine_image")

package(default_visibility = ["//tests:__subpackages__"])

exports_files(["make_jar.py"])

# zlib 1.3.1-r2: two HIGH and two MEDIUM vulnerabilities in the pinned DB.
alpine_image(
    name = "vulnerable",
    installed = ":zlib-1.3.1-r2.installed",
)

# zlib 1.4-r0: none.
alpine_image(
    name = "clean",
    installed = ":zlib-1.4-r0.installed",
)

# The vulnerable image as a docker-style tarball (oci_load's `tarball`
# output group), the other form trivy_image_test reads.
oci_load(
    name = "vulnerable_load",
    image = ":vulnerable",
    repo_tags = ["rules-trivy/vulnerable:test"],
)

filegroup(
    name = "vulnerable_tarball",
    srcs = [":vulnerable_load"],
    output_group = "tarball",
)

# A clean OS plus a jar Trivy identifies as log4j-core 2.14.1 (Log4Shell).
genrule(
    name = "log4j_jar",
    srcs = [":log4j-core.pom.properties"],
    outs = ["log4j-core-2.14.1.jar"],
    cmd = "python3 -I $(location :make_jar.py) $< org.apache.logging.log4j log4j-core $@",
    tools = [":make_jar.py"],
)

alpine_image(
    name = "java",
    files = {"app/log4j-core-2.14.1.jar": ":log4j_jar"},
    installed = ":zlib-1.4-r0.installed",
)

# For licence scans: busybox (GPL-2.0-only, restricted) next to zlib.
alpine_image(
    name = "gpl",
    installed = ":busybox-zlib.installed",
)

# The log4j jar (pom.properties only: no licence) and a jar whose pom.xml
# declares GPL-3.0-only.
genrule(
    name = "widget_jar",
    srcs = [
        ":widget.pom.properties",
        ":widget.pom.xml",
    ],
    outs = ["widget-1.2.3.jar"],
    cmd = "python3 -I $(location :make_jar.py) $(location :widget.pom.properties) com.example widget $@ $(location :widget.pom.xml)",
    tools = [":make_jar.py"],
)

alpine_image(
    name = "java_licenses",
    files = {
        "app/log4j-core-2.14.1.jar": ":log4j_jar",
        "app/widget-1.2.3.jar": ":widget_jar",
    },
    installed = ":zlib-1.4-r0.installed",
)

# A multi-platform index: the vulnerable image for amd64, the clean one for
# arm64. trivy_image_test(platform = ...) picks one.
alpine_image(
    name = "clean_arm64",
    architecture = "arm64",
    installed = ":zlib-1.4-r0.installed",
)

oci_image_index(
    name = "multiarch",
    images = [
        ":clean_arm64",
        ":vulnerable",
    ],
)
